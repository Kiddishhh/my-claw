{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Python: 当前文件（项目环境）",
      "type": "debugpy",
      "request": "launch",
      "program": "${file}",
      "python": "${workspaceFolder}\\.venv\\Scripts\\python.exe",
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "DevMate: Daytona 沙箱",
      "type": "debugpy",
      "request": "launch",
      "module": "scripts.devmate_with_mw",
      "python": "${workspaceFolder}\\.venv\\Scripts\\python.exe",
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "console": "integratedTerminal",
      "justMyCode": true,
      "args": [
        "--thread-id",
        "ide-session",
        "--task",
        "检查项目并总结，不修改文件"
      ]
    },
    {
      "name": "DevMate: 本地开发工具验收",
      "type": "debugpy",
      "request": "launch",
      "module": "tests.verify_development_tools",
      "python": "${workspaceFolder}\\.venv\\Scripts\\python.exe",
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "console": "integratedTerminal",
      "justMyCode": true,
      "args": [
        "--offline"
      ]
    }
  ]
}
